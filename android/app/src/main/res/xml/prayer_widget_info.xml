<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0: PrayerWidgetProvider schedules its own refresh at
     each prayer boundary / midnight instead of the system's 30-min minimum. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/prayer_widget_description"
    android:initialLayout="@layout/widget_prayer_times"
    android:minWidth="250dp"
    android:minHeight="56dp"
    android:minResizeWidth="250dp"
    android:previewLayout="@layout/widget_prayer_times"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
